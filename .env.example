# Clipfarm local pipeline. Copy to .env and edit. Every value is optional:
# with an empty file the pipeline still works end to end, for free.

# --- Local service -----------------------------------------------------------
PIPELINE_HOST=127.0.0.1
PIPELINE_PORT=8787
# Where the browser reaches the service (only change if you expose it).
PIPELINE_PUBLIC_URL=http://127.0.0.1:8787

# --- Transcription (faster-whisper, local, free) -----------------------------
# tiny | base | small | medium | large-v3 | large-v3-turbo
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# int8 (CPU) | float16 (GPU) | float32
WHISPER_COMPUTE=int8

# --- Clip selection ----------------------------------------------------------
MAX_CLIPS=5
MIN_CLIP_SECONDS=15
MAX_CLIP_SECONDS=60
TARGET_CLIP_SECONDS=32
MAX_SOURCE_HEIGHT=1080
# bold | clean | box
CAPTION_PRESET=bold

# --- Optional free LLM -------------------------------------------------------
# auto: try Ollama, then an OpenAI-compatible endpoint, else heuristics.
# ollama | openai | none
LLM_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Any OpenAI-compatible free tier (Groq, OpenRouter :free, etc.).
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=llama-3.1-8b-instant

# --- yt-dlp cookies (only for bot checks / private videos) -------------------
# Export cookies.txt with a browser extension, then point to it:
# YTDLP_COOKIES=/absolute/path/cookies.txt
# Or read cookies from a local browser profile: chrome | firefox | edge | brave
# YTDLP_COOKIES_FROM_BROWSER=

# --- Optional YouTube Shorts upload (official API only) ----------------------
# Create an OAuth client (Desktop app) in Google Cloud, enable YouTube Data API v3,
# download the JSON to secrets/youtube_client.json, then run:
#   .venv/bin/python -m pipeline.cli auth-youtube
# YOUTUBE_CLIENT_SECRETS=/absolute/path/youtube_client.json
# YOUTUBE_TOKEN_FILE=/absolute/path/youtube_token.json

# --- Tool paths (only if not using .tools/ and .venv/bin) --------------------
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# YTDLP_PATH=/usr/local/bin/yt-dlp

# --- Frontend (Vite) ---------------------------------------------------------
# Leave empty in development: Vite proxies /pipeline-api to 127.0.0.1:8787.
# Set a full URL only if the service runs on another host/port.
# VITE_PIPELINE_API=http://127.0.0.1:8787
